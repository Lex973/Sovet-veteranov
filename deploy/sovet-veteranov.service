# Systemd unit для FastAPI (Совет ветеранов)
# Разместить: /etc/systemd/system/sovet-veteranov.service
# Действия:
#   sudo systemctl daemon-reload
#   sudo systemctl enable sovet-veteranov
#   sudo systemctl start sovet-veteranov
#   sudo systemctl status sovet-veteranov

[Unit]
Description=Sovet Veteranov 74 API
After=network.target

[Service]
Type=simple
User=root
WorkingDirectory=/opt/sovet-veteranov/backend
Environment="PATH=/opt/sovet-veteranov/backend/venv/bin"
ExecStart=/opt/sovet-veteranov/backend/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=3

[Install]
WantedBy=multi-user.target
