# Пример .env для сервера
# Скопировать в /opt/sovet-veteranov/backend/.env и заполнить

DATABASE_URL=sqlite:///./sovet_veteranov.db
TELEGRAM_BOT_TOKEN=...
# Канал для дублирования новостей (бот должен быть админом канала). Пример: @sovetveteranov74
TELEGRAM_CHANNEL=@sovetveteranov74
ADMIN_PASSWORD=ваш_надёжный_пароль_админки
# Ссылка на сайт для сообщений бота (админка = SITE_URL/admin). Необязательно.
# SITE_URL=https://советветеранов74.рф
# URL бэкенда для бота (создание новостей из Telegram). По умолчанию http://127.0.0.1:8000
# API_BASE_URL=http://127.0.0.1:8000
